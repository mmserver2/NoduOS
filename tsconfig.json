{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "modules/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".git"
  ]
}
